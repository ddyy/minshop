---
import type { ProductCardModel } from '../../features/storefront/models';
import StoreImage from '../../features/storefront/controls/StoreImage.astro';

/**
 * Studio — a plate on a wall.
 *
 * No card chrome: no border, no panel, no rounded corner. The image is the
 * object and the caption sits beneath it, the way a print is labelled. The
 * whole tile is one link — an image-only anchor would have no text of its own,
 * and a second link to the same product makes every keyboard user tab twice.
 *
 * `index` drives a staggered reveal rather than a fixed one, so a grid resolves
 * in sequence instead of appearing all at once.
 */
interface Props {
  card: ProductCardModel;
  index?: number;
  headingLevel?: 'h2' | 'h3';
}

const { card, index = 0, headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
---

<li class="reveal group" style={`animation-delay:${Math.min(index, 8) * 90}ms`}>
  <a href={card.href} class="block">
    <div class="relative overflow-hidden bg-[color:var(--studio-well)]">
      <StoreImage
        image={card.image}
        fade
        class={`w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]${card.inStock ? '' : ' opacity-45'}`}
      />
      {
        !card.inStock && (
          <span class="absolute left-0 top-5 bg-[color:var(--studio-bone)] px-3 py-1.5 text-[9px] font-semibold uppercase tracking-[0.22em] text-[color:var(--color-paper)]">
            Sold out
          </span>
        )
      }
    </div>

    <div class="mt-5 flex items-baseline gap-4">
      <Heading class="font-serif text-2xl tracking-tight transition-colors group-hover:text-brand">
        {card.name}
      </Heading>
      <span class="ml-auto shrink-0 text-xs tracking-[0.12em] text-[color:var(--studio-muted)]">
        {card.formattedPrice}
      </span>
    </div>
  </a>
</li>
