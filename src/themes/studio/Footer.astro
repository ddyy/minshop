---
import type { StorefrontShellModel } from '../../features/storefront/models';

/**
 * Studio — the colophon. Set small and quiet at the foot of the page, the way a
 * catalogue credits itself.
 */
interface Props {
  model: StorefrontShellModel;
}

const { model } = Astro.props;
---

<footer class="border-t border-line">
  <div
    class="mx-auto flex max-w-[96rem] flex-wrap items-baseline gap-x-8 gap-y-3 px-12 py-14 text-[10px] font-medium uppercase tracking-[0.24em] text-[color:var(--studio-muted)]"
  >
    <span class="font-serif text-base normal-case tracking-normal text-[color:var(--studio-bone)]">
      {model.storeName}
    </span>
    {
      model.footerLinks.length > 0 && (
        <nav aria-label="Footer" class="flex flex-wrap items-center gap-x-8 gap-y-3">
          {model.footerLinks.map((link) => (
            <a href={link.href} class="hover:text-[color:var(--studio-bone)]">
              {link.text}
            </a>
          ))}
        </nav>
      )
    }
  </div>
</footer>
