---
import type { ProductDetailModel, ProductPurchaseModel } from '../../features/storefront/models';
import ProductCard from './ProductCard.astro';
import ProductGallery from '../../features/storefront/controls/ProductGallery.astro';
import ProductPurchaseForm from '../../features/storefront/controls/ProductPurchaseForm.astro';

/**
 * Studio — the work, then the label.
 *
 * Image left at seven columns, everything else right at four with a column of
 * air between. The name is set at display scale because on this page the
 * product name IS the headline; price and commerce chrome stay small so the
 * purchase is obvious without being loud.
 *
 * Recommendations are a story rather than a row: four plates on staggered
 * baselines, the same treatment as the wall.
 */
interface Props {
  model: ProductDetailModel;
  purchase: ProductPurchaseModel;
}

const { model, purchase } = Astro.props;
---

<a
  href={model.backHref}
  class="mt-10 inline-block text-[10px] font-medium uppercase tracking-[0.24em] text-[color:var(--studio-muted)] hover:text-brand"
>
  &larr; Back to shop
</a>

{
  model.error && (
    <p role="alert" class="mt-6 border-l-2 border-brand bg-[color:var(--studio-well)] px-4 py-3 text-sm">
      {model.error}
    </p>
  )
}

<div class="mt-8 grid gap-x-16 gap-y-12 pb-8 lg:grid-cols-12">
  <div class="reveal lg:col-span-7">
    <ProductGallery images={model.images} hero={model.heroImage} soldOut={model.soldOut} />
  </div>

  <div class="reveal lg:col-span-4 lg:col-start-9" style="animation-delay:120ms">
    {
      model.categories.length > 0 && (
        <nav
          aria-label="Categories"
          class="mb-7 flex flex-wrap gap-x-5 gap-y-1 text-[10px] font-medium uppercase tracking-[0.2em] text-brand"
        >
          {model.categories.map((category) => (
            <a href={category.href} class="hover:text-[color:var(--studio-bone)]">
              {category.text}
            </a>
          ))}
        </nav>
      )
    }

    <h1 class="font-serif text-[clamp(2.4rem,4.4vw,4rem)] font-normal leading-[0.95] tracking-[-0.03em]">
      {model.name}
    </h1>

    <p
      class="mt-6 text-sm tracking-[0.12em] text-[color:var(--studio-muted)]"
      data-price-display
      data-base={model.priceCents}
      data-currency={model.currency}
    >
      {model.priceVaries && <span>from </span>}
      {model.formattedPrice}
    </p>

    {model.lowStock && <p data-low-stock class="mt-2 text-xs tracking-[0.16em] text-brand">Low stock</p>}

    {
      model.descriptionHtml && (
        <div class="markdown-content mt-8 max-w-[38ch] leading-[1.8] text-[#b9b2a5]" set:html={model.descriptionHtml} />
      )
    }

    <ProductPurchaseForm model={purchase} />

    <button
      type="button"
      data-share
      data-share-title={model.name}
      class="mt-8 hidden w-fit items-center gap-2 text-[10px] font-medium uppercase tracking-[0.24em] text-[color:var(--studio-muted)] hover:text-brand"
    >
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="18" cy="5" r="3" /><circle cx="6" cy="12" r="3" /><circle cx="18" cy="19" r="3" />
        <line x1="8.6" y1="13.5" x2="15.4" y2="17.5" /><line x1="15.4" y1="6.5" x2="8.6" y2="10.5" />
      </svg>
      <span data-share-label>Share</span>
    </button>
  </div>
</div>

{
  model.related.length > 0 && (
    <section class="border-t border-line py-16">
      <h2 class="mb-12 text-[10px] font-medium uppercase tracking-[0.32em] text-[color:var(--studio-muted)]">
        You may also like
      </h2>
      <ul class="studio-story grid grid-cols-2 gap-x-8 gap-y-12 lg:grid-cols-4">
        {model.related.map((card, i) => (
          <ProductCard card={card} index={i} headingLevel="h3" />
        ))}
      </ul>
    </section>
  )
}

<style>
  /* The same staggered rhythm as the wall, at a smaller scale. */
  @media (min-width: 1024px) {
    .studio-story > :global(li:nth-child(2)) {
      margin-top: 3.5rem;
    }
    .studio-story > :global(li:nth-child(4)) {
      margin-top: 2rem;
    }
  }
  .studio-story :global(img) {
    aspect-ratio: 1 / 1;
  }
</style>
