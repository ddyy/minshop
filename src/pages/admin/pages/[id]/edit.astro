---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import MediaPicker from '../../../../features/media/MediaPicker.astro';
import { getPage } from '../../../../features/pages/db';
import {
  PAGE_LAYOUT_OPTIONS,
  normalizePageLayout,
} from '../../../../features/pages/layouts';

const id = Number(Astro.params.id);
const page = Number.isFinite(id) ? await getPage(env.DB, id) : null;
if (!page) return new Response('Not found', { status: 404 });

const error = Astro.url.searchParams.get('error');
const warning = Astro.url.searchParams.get('warning');
const saved = Astro.url.searchParams.has('saved');
const currentLayout = normalizePageLayout(page.layout);

// Shown only while the body is empty. Doubles as the Markdown cheat sheet for a
// merchant who has never written any — it covers exactly what the toolbar above
// can insert, so the buttons and the hint teach the same syntax.
const PLACEHOLDER = `## A section heading

Write your page in Markdown. Blank lines separate paragraphs.

**bold**  _italic_  \`code\`

- a bulleted list
- another item

1. a numbered list
2. another item

> a quotation

[a link](https://example.com)

![describe the image](/images/media/photo.webp)`;

// Toolbar buttons are declarative: each carries the syntax to wrap or insert,
// so the script stays one generic selection handler rather than nine.
const tools = [
  { action: 'prefix', value: '## ', label: 'H2', title: 'Heading' },
  { action: 'wrap', value: '**', label: 'B', title: 'Bold' },
  { action: 'wrap', value: '_', label: 'I', title: 'Italic' },
  { action: 'link', value: '', label: 'Link', title: 'Link' },
  { action: 'prefix', value: '- ', label: 'List', title: 'Bulleted list' },
  { action: 'prefix', value: '1. ', label: '1.', title: 'Numbered list' },
  { action: 'prefix', value: '> ', label: 'Quote', title: 'Blockquote' },
  { action: 'wrap', value: '`', label: 'Code', title: 'Inline code' },
];
---

<AdminLayout title={`Edit ${page.title}`} active="pages">
  <a href="/admin/pages" class="text-sm text-gray-500 hover:text-brand">&larr; Back to pages</a>
  <div class="mt-4 mb-6 flex flex-wrap items-center justify-between gap-4">
    <h1 class="font-serif text-3xl tracking-tight">Edit page</h1>
    {
      page.published !== 0 && (
        <a
          href={`/pages/${page.slug}`}
          target="_blank"
          rel="noopener"
          class="text-sm text-accent hover:underline"
        >
          View on store ↗
        </a>
      )
    }
  </div>

  {
    error && (
      <p class="mb-6 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
        {error}
      </p>
    )
  }
  {
    warning && (
      <p class="mb-6 rounded-md border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">
        {warning}
      </p>
    )
  }
  {
    saved && !warning && (
      <p class="mb-6 rounded-md border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800">
        Saved.
      </p>
    )
  }

  <form method="POST" action={`/api/admin/pages/${page.id}`} data-page-form>
    <div class="flex flex-wrap gap-4">
      <label class="block flex-1 text-xs uppercase tracking-widest text-gray-400">
        Title
        <input
          type="text"
          name="title"
          value={page.title}
          required
          maxlength="120"
          class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm normal-case tracking-normal text-gray-900 focus:border-brand focus:outline-none"
        />
      </label>
      <label class="block flex-1 text-xs uppercase tracking-widest text-gray-400">
        Slug
        <input
          type="text"
          name="slug"
          value={page.slug}
          class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm normal-case tracking-normal text-gray-900 focus:border-brand focus:outline-none"
        />
      </label>
    </div>

    {/* overflow-hidden so pane edges and inner scrollbars are clipped by the
        radius instead of painting over the border corners. */}
    <div class="mt-6 overflow-hidden rounded-md border border-line">
      {/* Markdown / Split / Preview. Rendered hidden and revealed by the script,
          because without JavaScript there is nothing to switch between — the
          textarea is the whole editor and the preview never populates. */}
      <div
        data-modes
        hidden
        role="group"
        aria-label="Editor view"
        class="flex items-center gap-1 border-b border-line px-2 py-2"
      >
        <button
          type="button"
          data-mode="write"
          class="rounded px-3 py-1.5 text-xs uppercase tracking-widest text-gray-500"
          aria-pressed="false"
        >
          Markdown
        </button>
        <button
          type="button"
          data-mode="split"
          class="rounded px-3 py-1.5 text-xs uppercase tracking-widest text-gray-500"
          aria-pressed="false"
        >
          Split
        </button>
        <button
          type="button"
          data-mode="preview"
          class="rounded px-3 py-1.5 text-xs uppercase tracking-widest text-gray-500"
          aria-pressed="false"
        >
          Preview
        </button>
      </div>

      {/* Split becomes two columns only where there's room for two readable
          measures; below lg it stacks, so the mode still means something on a
          phone instead of disappearing from the control. */}
      <div data-panes class="lg:divide-x lg:divide-line">
        {/* flex column so the textarea can fill the leftover height rather than
            claiming 100% of a parent that also contains the toolbar. */}
        <div data-pane="write" class="flex min-w-0 flex-col">
          <div
            data-toolbar
            class="flex min-h-11 flex-wrap items-center gap-1 border-b border-line px-2 py-1"
          >
            {
              tools.map((tool) => (
                <button
                  type="button"
                  data-tool={tool.action}
                  data-value={tool.value}
                  title={tool.title}
                  class="rounded px-2 py-1 text-xs text-gray-600 hover:bg-gray-100 hover:text-brand"
                >
                  {tool.label}
                </button>
              ))
            }
            {/* Compact trigger so the toolbar stays one row. At the default
                size it is 34px against the 24px tool buttons, which wrapped the
                toolbar onto a second line and pushed the editor 46px below the
                preview in split view. */}
            <MediaPicker
              id="page-body"
              label="Image"
              buttonClass="rounded px-2 py-1 text-xs text-gray-600 hover:bg-gray-100 hover:text-brand"
            />
          </div>

          {/* Never h-full: that resolves to 100% of the pane, and the pane is
              toolbar + textarea, so the textarea overshot by the toolbar's
              height and hung past the container's rounded border.
              The script sets min-height to the content height, so the field
              grows with the text and never scrolls on its own — the page
              scrolls instead. flex-1 still lets it stretch to fill the pane
              when the preview is the taller column. */}
          <textarea
            name="body_markdown"
            data-editor
            rows="24"
            spellcheck="true"
            placeholder={PLACEHOLDER}
            class="block w-full flex-1 resize-none overflow-hidden border-0 px-4 py-3 font-mono text-sm leading-relaxed focus:outline-none"
            >{page.body_markdown}</textarea
          >
        </div>

        {/* hidden attribute, not a class: visibility is entirely the script's
            job now, so there is no responsive utility to fight with. Starts
            hidden so a no-JS editor shows the textarea alone. */}
        <div data-pane="preview" hidden class="min-w-0 border-t border-line lg:border-t-0">
          <div
            class="flex h-11 items-center justify-between border-b border-line px-4 text-xs uppercase tracking-widest text-gray-400"
          >
            <span>Preview <span class="normal-case tracking-normal">· click to find the source</span></span>
            {/* Reserved space, so the row doesn't reflow each time it renders. */}
            <span data-preview-status class="text-gray-300"></span>
          </div>
          {/* Server-rendered by the same renderer the storefront uses. The
              endpoint supplies .markdown-content and the layout variables, so
              this pane shows the real measure and title alignment. */}
          <div data-preview class="overflow-x-auto px-4 py-3"></div>
        </div>
      </div>
    </div>

    {/* Options are generated from features/pages/layouts.ts — adding a preset
        there adds it here with no change to this file. */}
    <label class="mt-6 block max-w-sm text-xs uppercase tracking-widest text-gray-400">
      Layout
      <select
        name="layout"
        data-layout-select
        class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm normal-case tracking-normal text-gray-900 focus:border-brand focus:outline-none"
      >
        {
          PAGE_LAYOUT_OPTIONS.map((option) => (
            <option
              value={option.key}
              data-hint={option.hint}
              selected={option.key === currentLayout}
            >
              {option.label}
            </option>
          ))
        }
      </select>
      <span data-layout-hint class="mt-1 block normal-case tracking-normal text-gray-400">
        {PAGE_LAYOUT_OPTIONS.find((o) => o.key === currentLayout)?.hint}
      </span>
    </label>

    <div class="mt-6 flex flex-wrap items-center gap-4">
      <label class="flex items-center gap-2 text-sm text-gray-700">
        <input type="checkbox" name="published" checked={page.published !== 0} class="rounded" />
        Published
      </label>
      <button
        type="submit"
        class="rounded-md bg-brand px-4 py-2 text-xs font-medium uppercase tracking-wider text-white hover:bg-brand-hover"
      >
        Save
      </button>
      <span class="text-xs text-gray-400">
        Published pages appear in the footer and sitemap. Storefront caching means a change
        can take up to a minute to appear.
      </span>
    </div>
  </form>
</AdminLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-page-form]');
  const editor = form?.querySelector<HTMLTextAreaElement>('[data-editor]');
  const preview = form?.querySelector<HTMLElement>('[data-preview]');
  if (form && editor && preview) {
    /** Replace the selection, then restore a sensible cursor/selection. */
    const replaceSelection = (text: string, selectFrom: number, selectTo: number) => {
      const { selectionStart: start, selectionEnd: end } = editor;
      editor.setRangeText(text, start, end, 'preserve');
      editor.focus();
      editor.setSelectionRange(start + selectFrom, start + selectTo);
      editor.dispatchEvent(new Event('input', { bubbles: true }));
    };

    const selected = () => editor.value.slice(editor.selectionStart, editor.selectionEnd);

    form.querySelector('[data-toolbar]')?.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLElement>('[data-tool]');
      if (!button) return;
      const kind = button.dataset.tool;
      const value = button.dataset.value ?? '';
      const text = selected();

      if (kind === 'wrap') {
        // Wrapping keeps the selection so the same click can be undone by
        // pressing the button again mentally — and typing replaces the text.
        replaceSelection(`${value}${text}${value}`, value.length, value.length + text.length);
      } else if (kind === 'prefix') {
        // Line-oriented: apply to every selected line, not just the first.
        const body = (text || '').split('\n').map((line) => `${value}${line}`).join('\n');
        replaceSelection(body, 0, body.length);
      } else if (kind === 'link') {
        const label = text || 'link text';
        const md = `[${label}](https://)`;
        // Put the caret in the URL, which is the part that still needs typing.
        replaceSelection(md, md.length - 1, md.length - 1);
      }
    });

    // Media picker → insert an image at the cursor. Alt text is prompted for
    // rather than left empty: an unlabelled image is an accessibility failure,
    // and the filename is rarely a good description.
    document.addEventListener('media:selected', (event) => {
      const detail = (event as CustomEvent).detail as { imageKey: string; url: string };
      const raw = window.prompt('Describe this image for screen readers:', '') ?? '';
      // ] and \ would terminate or escape the alt span and corrupt the link.
      const alt = raw.replace(/([\\\]])/g, '\\$1');
      // Root-relative, never detail.url: with IMAGE_BASE_URL set that is an
      // absolute CDN address, which would be baked into the stored body. The
      // renderer applies the origin at render time and extractMediaKeys matches
      // this form, so changing IMAGE_BASE_URL never requires rewriting content.
      const md = `![${alt}](/images/${detail.imageKey})`;
      replaceSelection(md, 2, 2 + alt.length);
    });

    const status = form.querySelector<HTMLElement>('[data-preview-status]');
    const previewPane = form.querySelector<HTMLElement>('[data-pane="preview"]');
    const writePane = form.querySelector<HTMLElement>('[data-pane="write"]');
    // Cast rather than parameterise: the Workers `Element` type in scope here
    // doesn't satisfy querySelector's generic constraint for HTMLSelectElement.
    const layoutSelect = form.querySelector('[data-layout-select]') as HTMLSelectElement | null;
    const panes = form.querySelector<HTMLElement>('[data-panes]');
    const modeBar = form.querySelector<HTMLElement>('[data-modes]');
    const MODE_KEY = 'minshop:page-editor-mode';

    let inFlight: AbortController | null = null;
    let lastRendered: string | null = null;
    let timer: number | undefined;

    /** offsetParent is null while a pane is display:none — no point rendering. */
    const previewVisible = () => !!previewPane?.offsetParent;

    const render = async () => {
      if (!previewVisible()) return;
      const markdown = editor.value;
      // Every input the preview depends on belongs in this key. Leave one out
      // and a change to it looks identical to "nothing changed", so the render
      // is skipped.
      const key = `${layoutSelect?.value ?? ''} ${markdown}`;
      if (key === lastRendered) return; // nothing changed since the last render

      // Supersede any request still in flight: with fast typing the responses
      // can otherwise land out of order and leave stale HTML in the pane.
      inFlight?.abort();
      const controller = new AbortController();
      inFlight = controller;
      if (status) status.textContent = 'Rendering…';

      const body = new FormData();
      body.append('body_markdown', markdown);
      // Send the chosen layout so the preview uses the same measure and title
      // alignment the storefront will.
      if (layoutSelect) body.append('layout', layoutSelect.value);
      try {
        const res = await fetch('/api/admin/pages/preview', {
          method: 'POST',
          body,
          signal: controller.signal,
        });
        if (!res.ok) throw new Error(`Preview failed (${res.status})`);
        // Server-rendered by the same renderer the storefront uses, with raw
        // HTML disabled, so this is the storefront's own escaped output.
        preview.innerHTML = await res.text();
        lastRendered = key;
        if (status) status.textContent = '';
      } catch (err) {
        if (controller.signal.aborted) return; // superseded, not a failure
        if (status) status.textContent = '';
        preview.textContent = err instanceof Error ? err.message : 'Preview failed.';
      } finally {
        if (inFlight === controller) inFlight = null;
      }
    };

    /**
     * Grow the field to its content so it never scrolls on its own — one page
     * scrollbar instead of a nested one. min-height rather than height, so
     * flex-1 can still stretch it to fill the pane when the preview is taller.
     * Runs unthrottled: it is a layout read/write on one element, not a fetch.
     */
    /**
     * Floor of `rows` lines. Without it an empty page collapses to a single
     * line, which would clip the multi-line Markdown placeholder to its first
     * row — exactly when a merchant most needs to read it.
     */
    const minRowsHeight = () => {
      const cs = getComputedStyle(editor);
      const line = parseFloat(cs.lineHeight) || 20;
      const rows = Number(editor.rows) || 10;
      return rows * line + parseFloat(cs.paddingTop) + parseFloat(cs.paddingBottom);
    };

    const autosize = () => {
      // A hidden textarea reports scrollHeight 0; skip so it isn't collapsed.
      if (!editor.offsetParent) return;
      editor.style.minHeight = '0px';
      editor.style.minHeight = `${Math.max(editor.scrollHeight, minRowsHeight())}px`;
    };

    /** Trailing debounce: render once typing pauses, not on every keystroke. */
    const scheduleRender = () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(render, 350);
    };

    editor.addEventListener('input', () => {
      autosize();
      scheduleRender();
    });
    layoutSelect?.addEventListener('change', scheduleRender);
    // Wrapping changes with the pane width, so the height has to be recomputed.
    window.addEventListener('resize', autosize);

    /** Character offset where a 1-based source line starts. */
    const offsetOfLine = (line: number) => {
      const lines = editor.value.split('\n');
      let offset = 0;
      for (let i = 0; i < Math.min(line - 1, lines.length); i++) offset += lines[i].length + 1;
      return offset;
    };

    /**
     * Vertical offset of a character within the field, in pixels.
     *
     * Counting newlines is not enough: the textarea soft-wraps, so one source
     * line can occupy many visual rows and a paragraph-based estimate drifts
     * further the longer the document gets. This mirrors the text into a hidden
     * div with the same width, font, and padding, so the browser reproduces the
     * exact wrapping and the marker's offsetTop is the real position.
     */
    const caretTopWithin = (offset: number): number => {
      const cs = getComputedStyle(editor);
      const mirror = document.createElement('div');
      for (const prop of [
        'fontFamily', 'fontSize', 'fontWeight', 'fontStyle', 'letterSpacing',
        'lineHeight', 'textTransform', 'wordSpacing', 'textIndent', 'tabSize',
        'paddingTop', 'paddingRight', 'paddingBottom', 'paddingLeft',
        'borderTopWidth', 'borderRightWidth', 'borderBottomWidth', 'borderLeftWidth',
        'boxSizing',
      ] as const) {
        mirror.style[prop] = cs[prop];
      }
      mirror.style.position = 'absolute';
      mirror.style.visibility = 'hidden';
      mirror.style.left = '-9999px';
      mirror.style.top = '0';
      mirror.style.height = 'auto';
      mirror.style.whiteSpace = 'pre-wrap';
      mirror.style.overflowWrap = 'break-word';
      mirror.style.width = `${editor.getBoundingClientRect().width}px`;

      const marker = document.createElement('span');
      // A non-empty marker so it has a box even at the very end of the text.
      marker.textContent = editor.value.slice(offset, offset + 1) || '.';
      // appendChild, not append: the Workers types in scope here resolve
      // `append` to a non-DOM signature.
      mirror.appendChild(document.createTextNode(editor.value.slice(0, offset)));
      mirror.appendChild(marker);
      document.body.appendChild(mirror);
      const top = marker.offsetTop;
      mirror.remove();
      return top;
    };

    /** Select a range, focus the field, and bring it into view. */
    const selectRange = (start: number, end: number) => {
      editor.focus();
      editor.setSelectionRange(start, end);

      // The field never scrolls internally (it grows to fit), so scrolling the
      // PAGE to the caret is what actually reveals it.
      const caretTop = editor.getBoundingClientRect().top + window.scrollY + caretTopWithin(start);
      const lineHeight = parseFloat(getComputedStyle(editor).lineHeight) || 20;
      const viewTop = window.scrollY;
      const viewBottom = viewTop + window.innerHeight;
      // Leave it alone when it is already comfortably on screen — scrolling on
      // every click would yank the page around for no reason.
      if (caretTop > viewTop + lineHeight * 2 && caretTop < viewBottom - lineHeight * 3) return;
      window.scrollTo({
        top: Math.max(0, caretTop - window.innerHeight / 3),
        behavior: 'smooth',
      });
    };

    /**
     * Word boundaries around an offset, roughly as a double-click would pick
     * them. Letters and digits from any script, plus the apostrophes and hyphens
     * that sit inside words ("don't", "size-chart"). Clicking whitespace or
     * punctuation returns a collapsed range, so the caret just lands there.
     */
    const WORD_CHAR = /[\p{L}\p{N}_'’-]/u;
    const wordAround = (text: string, offset: number): [number, number] => {
      const onWord = WORD_CHAR.test(text[offset] ?? '');
      // Clicking immediately after a word still selects that word.
      const anchor = onWord ? offset : WORD_CHAR.test(text[offset - 1] ?? '') ? offset - 1 : -1;
      if (anchor < 0) return [offset, offset];
      let start = anchor;
      let end = anchor;
      while (start > 0 && WORD_CHAR.test(text[start - 1])) start--;
      while (end < text.length && WORD_CHAR.test(text[end])) end++;
      return [start, end];
    };

    /** Rendered-text offset of a click, measured within `block`. */
    const renderedOffsetAt = (block: HTMLElement, x: number, y: number): number | null => {
      // caretPositionFromPoint is the standard; WebKit still ships the older
      // caretRangeFromPoint. Without either we fall back to the whole line.
      // Cast through unknown rather than intersecting with Document: the lib
      // declaration marks caretRangeFromPoint deprecated, and it is still the
      // only one WebKit implements, so intersecting would flag every use.
      const doc = document as unknown as {
        caretPositionFromPoint?: (x: number, y: number) => { offsetNode: Node; offset: number } | null;
        caretRangeFromPoint?: (x: number, y: number) => Range | null;
      };
      let node: Node | null = null;
      let offset = 0;
      const pos = doc.caretPositionFromPoint?.(x, y);
      if (pos) {
        node = pos.offsetNode;
        offset = pos.offset;
      } else {
        const range = doc.caretRangeFromPoint?.(x, y);
        if (!range) return null;
        node = range.startContainer;
        offset = range.startOffset;
      }
      if (!node || !block.contains(node)) return null;

      // Sum the text preceding the clicked node inside this block.
      const walker = document.createTreeWalker(block, NodeFilter.SHOW_TEXT);
      let total = 0;
      let current: Node | null;
      while ((current = walker.nextNode())) {
        if (current === node) return total + offset;
        total += current.textContent?.length ?? 0;
      }
      return null;
    };

    /**
     * Map an offset in a block's RENDERED text to an offset in its SOURCE.
     *
     * Rendered text is the source with the syntax taken out, so walking both and
     * advancing the rendered pointer only on a match lands on the right
     * character: `**bold**` skips the asterisks, `- item` skips the marker, and
     * `[label](url)` matches the label then skips the target.
     *
     * It can drift inside an unusual construct, and then the caret is a few
     * characters off. The BLOCK is still right, because that comes from the
     * parser's own source map rather than from this heuristic.
     */
    const mapRenderedToSource = (
      source: string,
      renderedText: string,
      renderedOffset: number,
    ): number => {
      const target = Math.min(renderedOffset, renderedText.length);
      let si = 0;
      let ri = 0;
      while (ri < target && si < source.length) {
        if (source[si] === renderedText[ri]) ri++;
        si++;
      }
      return si;
    };

    // Click anywhere in the preview to land on the source that produced it.
    // Blocks carry their source line range; an image selects its whole
    // ![alt](src) span so it can be edited or replaced wholesale.
    preview.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      const block = target.closest<HTMLElement>('[data-source-line]');
      if (!block) return;
      const line = Number(block.dataset.sourceLine);
      if (!Number.isFinite(line)) return;

      // Measure the click BEFORE anything can change the layout: switching mode
      // hides this pane, and once it is out of the layout there is no caret
      // position to read from those coordinates.
      const blockText = block.textContent ?? '';
      const renderedOffset = renderedOffsetAt(
        block,
        (event as MouseEvent).clientX,
        (event as MouseEvent).clientY,
      );

      // In Preview-only mode the editor is hidden, so there is nowhere to put
      // the caret. Switch to the source view — the click is a request to go and
      // edit this, and making the user switch manually would lose the spot they
      // picked. Measuring the caret's position also needs the field visible.
      if (writePane?.hidden) setMode('write');

      const lineStart = offsetOfLine(line);

      if (target.tagName === 'IMG') {
        // Inline tokens have no source map, so find the image syntax at or after
        // the block's first line. Images are inserted on their own line, so this
        // is exact for anything the editor wrote.
        const match = /!\[[^\]]*\]\([^)]*\)/.exec(editor.value.slice(lineStart));
        if (match) {
          const start = lineStart + match.index;
          selectRange(start, start + match[0].length);
          return;
        }
      }

      const endLine = Number(block.dataset.sourceEnd);
      const blockEnd = Number.isFinite(endLine)
        ? offsetOfLine(endLine)
        : (editor.value.indexOf('\n', lineStart) + 1 || editor.value.length);

      if (renderedOffset !== null) {
        const caret =
          lineStart +
          mapRenderedToSource(
            editor.value.slice(lineStart, blockEnd),
            blockText,
            renderedOffset,
          );
        // Select the word under the click. Highlighting it makes the landing
        // spot visible — a bare caret in a wall of monospace is easy to lose —
        // and it is immediately replaceable by typing.
        const [start, end] = wordAround(editor.value, caret);
        selectRange(start, end);
        return;
      }

      // No caret API — select the line so the click still does something useful.
      const lineEnd = editor.value.indexOf('\n', lineStart);
      selectRange(lineStart, lineEnd === -1 ? editor.value.length : lineEnd);
    });

    // Markdown / Split / Preview. The control only exists with JavaScript, so
    // it is revealed here rather than rendered visible and then broken.
    const modeButtons = form.querySelectorAll<HTMLButtonElement>('[data-mode]');
    const setMode = (mode: string) => {
      modeButtons.forEach((button) => {
        const active = button.dataset.mode === mode;
        button.setAttribute('aria-pressed', String(active));
        button.classList.toggle('bg-gray-100', active);
        button.classList.toggle('text-gray-700', active);
        button.classList.toggle('text-gray-500', !active);
      });
      if (writePane) writePane.hidden = mode === 'preview';
      if (previewPane) previewPane.hidden = mode === 'write';
      // Two columns only in split, and only where two measures fit.
      panes?.classList.toggle('lg:grid', mode === 'split');
      panes?.classList.toggle('lg:grid-cols-2', mode === 'split');
      try {
        localStorage.setItem(MODE_KEY, mode);
      } catch {
        // Private browsing or storage disabled — the mode just won't persist.
      }
      // The pane may have been hidden while edits happened, so catch it up.
      if (mode !== 'write') render();
      // The field measures as 0 while hidden, so size it once it is on screen
      // and after the column width has changed.
      autosize();
    };

    modeButtons.forEach((button) =>
      button.addEventListener('click', () => setMode(button.dataset.mode!)),
    );
    if (modeBar) modeBar.hidden = false;

    let initial = 'split';
    try {
      const stored = localStorage.getItem(MODE_KEY);
      if (stored === 'write' || stored === 'split' || stored === 'preview') initial = stored;
    } catch {
      // Ignore and use the default.
    }
    setMode(initial); // also performs the first render

    // Keep the hint in step with the dropdown. Hints are read from the rendered
    // options' data attributes, so this needs no per-preset code either.
    // (layoutSelect is declared above, next to the preview renderer.)
    const layoutHint = form.querySelector<HTMLElement>('[data-layout-hint]');
    layoutSelect?.addEventListener('change', () => {
      const hint = layoutSelect.selectedOptions[0]?.dataset.hint;
      if (layoutHint && hint) layoutHint.textContent = hint;
    });
  }
</script>

<style is:global>
  /* The preview HTML is injected at runtime, so Astro's scoped styles can't
     reach it — hence is:global, narrowed to [data-preview] which exists only
     on this screen. Signals that blocks are clickable. */
  [data-preview] [data-source-line] {
    cursor: pointer;
    border-radius: 2px;
  }
  [data-preview] [data-source-line]:hover {
    background: rgba(0, 0, 0, 0.035);
  }
</style>
