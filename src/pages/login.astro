---
import { getConfig } from '../config';
import { memberAccessMode } from '../features/auth/memberAccess';
import '../styles/global.css';

const mode = memberAccessMode(Astro.locals.settings);
if (mode === 'off') {
  return Astro.redirect('/', 303);
}

const error = Astro.url.searchParams.has('error');
const nextRaw = Astro.url.searchParams.get('next') ?? '';
const next = nextRaw.startsWith('/') && !nextRaw.startsWith('//') ? nextRaw : '/';
const storeName = Astro.locals.settings?.storeName || getConfig().storeName;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <title>Member access · {storeName}</title>
  </head>
  <body class="min-h-screen bg-surface text-foreground">
    <main class="mx-auto flex min-h-screen max-w-md items-center px-5 py-12">
      <section class="w-full rounded-xl border border-line bg-white p-7 shadow-sm sm:p-10">
        <p class="text-xs uppercase tracking-[0.22em] text-muted">Members only</p>
        <h1 class="mt-3 font-serif text-3xl tracking-tight">{storeName}</h1>
        <p class="mt-3 text-sm leading-6 text-muted">
          Enter a members’ access code to continue.
        </p>
        {error && (
          <p role="alert" class="mt-5 rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-800">
            That access code wasn’t recognised.
          </p>
        )}
        <form method="post" action="/api/member-login" class="mt-7 space-y-4">
          <input type="hidden" name="next" value={next} />
          <label class="block text-sm font-medium" for="member-code">Members’ access code</label>
          <input
            id="member-code"
            name="code"
            type="password"
            autocomplete="current-password"
            required
            autofocus
            class="w-full rounded-md border border-line bg-white px-3 py-3 outline-none focus:border-brand focus:ring-2 focus:ring-brand/20"
          />
          <button class="w-full rounded-md bg-brand px-4 py-3 text-sm font-semibold text-white hover:bg-brand-hover focus:outline-none focus:ring-2 focus:ring-brand focus:ring-offset-2">
            Continue
          </button>
        </form>
      </section>
    </main>
  </body>
</html>
