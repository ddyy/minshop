---
import {
  productImageSources,
  type ImageDelivery,
  type ProductImageUsage,
} from './image';
import { getConfig } from '../../config';

interface Props {
  imageKey: string | null;
  alt: string;
  class?: string;
  /** Reserve eager/high-priority loading for the page's likely LCP image. */
  priority?: boolean;
  sizes?: string;
  usage?: ProductImageUsage;
  /** Fade the bitmap over its neutral frame once the browser reports it loaded.
   *  Ignored for `priority` images — see the data-image-fade binding below. */
  fade?: boolean;
  /** Explicit mode for fragments that do not load the full settings overlay. */
  delivery?: ImageDelivery;
}

// Renders a product image, or the shared placeholder when there's none — so
// callers never branch on image_key and every product image is requested the
// same way. The fallback decision lives once, in productImageUrl().
const {
  imageKey,
  alt,
  class: className = '',
  priority = false,
  sizes,
  usage = priority ? 'detail' : 'card',
  fade = false,
  delivery,
} = Astro.props;
const sources = productImageSources(imageKey, {
  baseUrl: getConfig().images.baseUrl,
  delivery: delivery ?? Astro.locals.settings?.imageDelivery,
  usage,
  sizes,
});
---

{/* width/height are a square (1:1) aspect hint to reserve space (no CLS) — the
    actual display size comes from `class`. All product images + the placeholder
    are square; object-cover crops anything that isn't.

    A priority image never fades: `priority` marks the likely LCP element and asks
    the browser to fetch it first, but an opacity:0 element isn't a valid LCP
    candidate, so fading would hold the paint back until the load event, an
    attribute flip and a 180ms transition — undoing the head start. Enforced here
    rather than at the call sites so the two can't be combined by mistake. */}
<img
  src={sources.src}
  srcset={sources.srcset}
  alt={alt}
  class={className}
  width="600"
  height="600"
  loading={priority ? 'eager' : 'lazy'}
  fetchpriority={priority ? 'high' : 'auto'}
  decoding="async"
  sizes={sources.sizes}
  data-image-fade={fade && !priority ? '' : undefined}
/>
