---
import {
  productImageSources,
  type ImageDelivery,
  type ProductImageUsage,
} from './image';
import { getConfig } from '../../config';

interface Props {
  imageKey: string | null;
  alt: string;
  class?: string;
  /** Reserve eager/high-priority loading for the page's likely LCP image. */
  priority?: boolean;
  sizes?: string;
  usage?: ProductImageUsage;
  /** Explicit mode for fragments that do not load the full settings overlay. */
  delivery?: ImageDelivery;
}

// Renders a product image, or the shared placeholder when there's none — so
// callers never branch on image_key and every product image is requested the
// same way. The fallback decision lives once, in productImageUrl().
const {
  imageKey,
  alt,
  class: className = '',
  priority = false,
  sizes,
  usage = priority ? 'detail' : 'card',
  delivery,
} = Astro.props;
const sources = productImageSources(imageKey, {
  baseUrl: getConfig().images.baseUrl,
  delivery: delivery ?? Astro.locals.settings?.imageDelivery,
  usage,
  sizes,
});
---

{/* width/height are a square (1:1) aspect hint to reserve space (no CLS) — the
    actual display size comes from `class`. All product images + the placeholder
    are square; object-cover crops anything that isn't. */}
<img
  src={sources.src}
  srcset={sources.srcset}
  alt={alt}
  class={className}
  width="600"
  height="600"
  loading={priority ? 'eager' : 'lazy'}
  fetchpriority={priority ? 'high' : 'auto'}
  decoding="async"
  sizes={sources.sizes}
/>
